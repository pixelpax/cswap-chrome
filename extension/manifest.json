{
  "manifest_version": 3,
  "name": "cswap-chrome (claude.ai session follower)",
  "version": "0.1.0",
  "description": "Keeps Chrome's claude.ai session on whichever Claude account the cswap CLI is currently switched to.",
  "key": "",
  "permissions": ["cookies", "storage", "tabs", "alarms", "nativeMessaging", "notifications"],
  "host_permissions": ["https://claude.ai/*", "https://*.claude.ai/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icon-128.png" }
}
